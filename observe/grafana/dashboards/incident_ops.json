{
  "id": null,
  "uid": "indusbase-incident-ops",
  "title": "Incident Operations",
  "timezone": "Asia/Kolkata",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": ["indusbase", "incident", "status"],
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Incident Count by Severity",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "refId": "A", "expr": "platform:incident_count_by_severity" }]
    },
    {
      "type": "stat",
      "title": "Open Incidents",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "refId": "A", "expr": "sum(status_incidents_total{status!=\"resolved\"})" }]
    },
    {
      "type": "logs",
      "title": "Status Service Logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": "Loki",
      "targets": [{ "refId": "A", "expr": "{service=\"indus-status\"}" }]
    }
  ]
}
