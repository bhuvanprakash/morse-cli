# ============================================================================
# IndusBase - Environment Configuration Example
# Copy this file to .env and fill in your actual values
# ============================================================================

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
POSTGRES_USER=indus_admin
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=indusbase
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=require

# Connection pool settings
DB_POOL_SIZE=100
DB_MAX_CONNS=200
DB_MIN_CONNS=10
DB_CONN_TIMEOUT=30
DB_IDLE_TIMEOUT=300
DB_MAX_LIFETIME=3600

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password
REDIS_DB=0
REDIS_SSL=false

# Cache TTL settings (in seconds)
REDIS_RESULT_CACHE_TTL=300
REDIS_SCHEMA_CACHE_TTL=60
REDIS_SESSION_TTL=86400

# =============================================================================
# JWT Authentication Secrets
# =============================================================================
# Generate strong secrets using: openssl rand -base64 64
JWT_SECRET=change_this_jwt_secret_key_min_32_chars_long
JWT_REFRESH_SECRET=change_this_refresh_secret_key_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=indusbase
JWT_AUDIENCE=indusbase.io

# =============================================================================
# OAuth Credentials - Google
# =============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback
GOOGLE_ENABLED=false

# =============================================================================
# OAuth Credentials - GitHub
# =============================================================================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8001/auth/github/callback
GITHUB_ENABLED=false

# =============================================================================
# OAuth Credentials - Microsoft
# =============================================================================
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:8001/auth/microsoft/callback
MICROSOFT_ENABLED=false

# =============================================================================
# SMTP Email Configuration
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=noreply@indusbase.io
SMTP_FROM_NAME=IndusBase
SMTP_TLS=true
SMTP_AUTH=true

# =============================================================================
# TLS/SSL Certificate Paths
# =============================================================================
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
TLS_CA_PATH=./certs/ca.crt
TLS_ENABLED=false

# =============================================================================
# Internal Service Authentication
# =============================================================================
# Shared secret for inter-service communication
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=change_this_internal_api_key_for_service_auth

# Service URLs (internal)
AUTH_SERVICE_URL=http://indus-auth:8001
QUERY_SERVICE_URL=http://indus-query:8002
META_SERVICE_URL=http://indus-meta:8003
POOL_SERVICE_URL=http://indus-pool:5432

# =============================================================================
# Rate Limiting Configuration
# =============================================================================
# Requests per second
RATE_LIMIT_REQ_PER_SEC=100
RATE_LIMIT_BURST=200

# Gateway rate limits (higher for edge)
GATEWAY_RATE_LIMIT_REQ_PER_SEC=1000
GATEWAY_RATE_LIMIT_BURST=2000

# Auth service rate limits (stricter)
AUTH_RATE_LIMIT_REQ_PER_SEC=10
AUTH_RATE_LIMIT_BURST=20

# =============================================================================
# Query Service Configuration
# =============================================================================
QUERY_MAX_EXECUTION_TIME_MS=30000
QUERY_MAX_ROWS_RETURNED=10000
QUERY_STATEMENT_TIMEOUT_MS=25000
QUERY_ALLOW_DDL=false
QUERY_ALLOW_DML=true
QUERY_LOG_SLOW_THRESHOLD_MS=1000
QUERY_ENABLE_QUERY_CACHE=true
QUERY_CACHE_TTL_SECONDS=300

# =============================================================================
# Metadata Service Configuration
# =============================================================================
META_CACHE_TTL_SECONDS=60
META_ENABLE_SCHEMA_INTROSPECTION=true
META_MAX_TABLES_PER_REQUEST=100

# =============================================================================
# Gateway Service Configuration
# =============================================================================
GATEWAY_TIMEOUT_SECONDS=30
GATEWAY_MAX_REQUEST_SIZE_MB=10
GATEWAY_ENABLE_CORS=true
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
GATEWAY_ENABLE_REQUEST_ID=true
GATEWAY_ENABLE_REQUEST_LOGGING=true

# =============================================================================
# Logging Configuration
# =============================================================================
RUST_LOG=info
RUST_BACKTRACE=1

# Log levels per module (optional)
# RUST_LOG=indus_gate=debug,indus_auth=info,indus_query=warn,error

# =============================================================================
# Monitoring & Observability
# =============================================================================
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=true
TRACING_ENDPOINT=http://jaeger:14268/api/traces

# =============================================================================
# Development Settings
# =============================================================================
DEV_MODE=true
DEBUG_MODE=false
HOT_RELOAD=false

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_SIGNUP=true
ENABLE_OAUTH_LOGIN=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_MFA=false
ENABLE_AUDIT_LOG=true

# =============================================================================
# Replication
# =============================================================================
DB_REPLICATION_PASSWORD=replication_password_here

# =============================================================================
# Storage Configuration
# =============================================================================
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=indusbase
S3_REGION=ap-south-1
MAX_FILE_SIZE_MB=50
SIGNED_URL_EXPIRY_SECS=3600

# =============================================================================
# AI/ML Configuration
# =============================================================================
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
COHERE_API_KEY=

# =============================================================================
# Monitoring & Alerting
# =============================================================================
GRAFANA_PASSWORD=indusbase
ALERT_EMAIL=
ALERT_EMAIL_PASSWORD=

# indus-notify
FCM_CREDENTIALS_JSON=
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false
TWOFACTOR_API_KEY=
TWOFACTOR_SENDER_ID=INDUBS
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_NAME=IndusBase
EMAIL_FROM_ADDRESS=noreply@indusbase.com

# indus-config
CONFIG_ENCRYPTION_KEY=change_this_32_char_key_in_prod!!

# Phase 8: enterprise + ops maturity
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_ENCRYPTION_KEY=change_this_32_char_platform_key!!
SAML_SIGNING_CERT=
SAML_SIGNING_KEY=
SCIM_TOKEN_SIGNING_SECRET=change_this_scim_signing_secret
STATUS_PUBLIC_BASE_URL=http://localhost:8000
SUPPORT_CONTACT_EMAIL=support@indusbase.com
SUPPORT_IMPERSONATION_SECRET=change_this_impersonation_secret
