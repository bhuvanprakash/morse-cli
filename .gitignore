# =============================================================================
# IndusBase Monorepo - Global .gitignore
# =============================================================================

# =============================================================================
# Environment & Secrets
# =============================================================================
.env
.env.local
.env.*.local
.env.production
.env.staging
!.env.example
!.env.test

# =============================================================================
# Rust - indus-auth, indus-query, indus-meta
# =============================================================================
# Rust build artifacts
**/target/
**/Cargo.lock
**/*.rs.bk
**/*.pdb

# Rust profiling
**/flamegraph.svg
**/perf.data
**/perf.data.old

# Cargo
**/.cargo/
!**/.cargo/config.toml

# =============================================================================
# Go - indus-pool
# =============================================================================
# Go binaries
bin/
*.exe
*.dll
*.so
*.dylib

# Go workspace
vendor/

# Go test binaries
*.test

# Go coverage
*.out
coverage.html
coverage.txt

# Go build cache
*.o
*.a

# =============================================================================
# Zig - indus-gate
# =============================================================================
# Zig build artifacts
**/zig-out/
**/.zig-cache/

# =============================================================================
# Node.js / JavaScript / TypeScript
# =============================================================================
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Package managers
package-lock.json
yarn.lock
.pnp.cjs
.pnp.loader.mjs

# Build outputs
dist/
build/
.next/
.nuxt/
.output/
.vuepress/dist
.docusaurus/
.cache/
.parcel-cache/

# TypeScript
*.tsbuildinfo

# =============================================================================
# Docker
# =============================================================================
# Docker Compose overrides
docker-compose.override.yml
docker-compose.*.yml
!docker-compose.example.yml

# Docker volumes
docker-volumes/
volumes/
data/

# Docker build cache
.dockerignore

# =============================================================================
# TLS Certificates & Keys
# =============================================================================
certs/
*.pem
*.key
*.crt
*.csr
*.der
*.p12
*.pfx

# Keep example certs
!certs/example.crt
!certs/example.key

# =============================================================================
# IDE & Editor
# =============================================================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, GoLand, RustRover, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# Sublime
*.sublime-project
*.sublime-workspace

# =============================================================================
# OS Generated Files
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp

# Linux
*~
.nfs*

# =============================================================================
# Logs
# =============================================================================
logs/
*.log
*.log.*

# =============================================================================
# Database
# =============================================================================
*.db
*.sqlite
*.sqlite3
*.duckdb

# PostgreSQL
*.dump
*.backup
*.sql.gz

# =============================================================================
# Testing & CI
# =============================================================================
# Test artifacts
test-results/
*.junit.xml
junit.xml

# Coverage reports
coverage/
.nyc_output/

# =============================================================================
# Temporary Files
# =============================================================================
tmp/
temp/
*.tmp
*.temp
*.cache
*.pid
*.seed
*.pid.lock

# =============================================================================
# Documentation Build
# =============================================================================
site/
book/
docs/_build/
docs/_site/

# =============================================================================
# Misc
# =============================================================================
# Local notes
TODO.local.md
NOTES.local.md

# Backup files
*.bak
*.orig
*.rej

# Keep structure
!.gitkeep
