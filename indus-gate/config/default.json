{
    "server": {
        "port": 8000,
        "host": "0.0.0.0",
        "read_timeout_ms": 30000,
        "write_timeout_ms": 30000,
        "max_request_size_mb": 10
    },
    "upstreams": {
        "api": {
            "name": "api-service",
            "urls": [
                "http://localhost:8081"
            ],
            "health_check_path": "/health",
            "health_check_interval_sec": 30,
            "timeout_ms": 5000,
            "retries": 3,
            "circuit_breaker": {
                "failure_threshold": 5,
                "reset_timeout_sec": 30
            }
        },
        "auth": {
            "name": "auth-service",
            "urls": [
                "http://localhost:8082"
            ],
            "health_check_path": "/health",
            "health_check_interval_sec": 30,
            "timeout_ms": 3000,
            "retries": 2,
            "circuit_breaker": {
                "failure_threshold": 3,
                "reset_timeout_sec": 10
            }
        },
        "websocket": {
            "name": "websocket-service",
            "urls": [
                "http://localhost:8083"
            ],
            "health_check_path": "/health",
            "health_check_interval_sec": 30,
            "timeout_ms": 0,
            "retries": 1,
            "circuit_breaker": {
                "failure_threshold": 5,
                "reset_timeout_sec": 30
            }
        },
        "live": {
            "name": "live-service",
            "urls": [
                "http://indus-live:8004"
            ],
            "health_check_path": "/health",
            "health_check_interval_sec": 30,
            "timeout_ms": 5000,
            "retries": 3,
            "circuit_breaker": {
                "failure_threshold": 5,
                "reset_timeout_sec": 30
            }
        },
        "store": {
            "name": "store-service",
            "urls": [
                "http://indus-store:8005"
            ],
            "health_check_path": "/health",
            "health_check_interval_sec": 30,
            "timeout_ms": 10000,
            "retries": 3,
            "circuit_breaker": {
                "failure_threshold": 5,
                "reset_timeout_sec": 30
            }
        }
    },
    "routes": [
        {
            "path": "/api/*",
            "upstream": "api",
            "strip_prefix": false,
            "auth_required": true
        },
        {
            "path": "/auth/*",
            "upstream": "auth",
            "strip_prefix": false,
            "auth_required": false
        },
        {
            "path": "/ws/*",
            "upstream": "websocket",
            "strip_prefix": false,
            "auth_required": true
        },
        {
            "path": "/realtime/*",
            "upstream": "live",
            "strip_prefix": false,
            "auth_required": true,
            "websocket_upgrade": true
        },
        {
            "path": "/storage/*",
            "upstream": "store",
            "strip_prefix": false,
            "auth_required": true
        }
    ],
    "rate_limit": {
        "enabled": true,
        "requests_per_second": 100,
        "burst_capacity": 150,
        "key_prefix": "ratelimit:",
        "block_duration_sec": 60
    },
    "cors": {
        "enabled": true,
        "allowed_origins": [
            "http://localhost:3000",
            "http://localhost:5173",
            "https://app.indusbase.com"
        ],
        "allowed_methods": [
            "GET",
            "POST",
            "PUT",
            "DELETE",
            "PATCH",
            "OPTIONS"
        ],
        "allowed_headers": [
            "Authorization",
            "Content-Type",
            "X-Request-ID"
        ],
        "exposed_headers": [
            "X-Request-ID"
        ],
        "max_age_sec": 86400,
        "allow_credentials": true
    },
    "jwt": {
        "header_name": "Authorization",
        "header_prefix": "Bearer ",
        "claims_validate": [
            "sub",
            "exp"
        ]
    },
    "logging": {
        "level": "info",
        "format": "json",
        "output": "stdout",
        "include_request_body": false,
        "include_response_body": false
    },
    "tls": {
        "enabled": false,
        "cert_file": "",
        "key_file": ""
    }
}